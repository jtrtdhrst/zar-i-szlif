{
  "name": "kompas-zbiorek-ui-plugin",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "build": "node web/scripts/build-static.mjs && tsc -p plugin/tsconfig.json",
    "lint": "node --check web/scripts/build-static.mjs && node --check web/scripts/skill-completion-task-test.mjs && node --check plugin/index.ts",
    "test": "npm run test:skill-completion-task",
    "test:skill-completion-task": "node web/scripts/skill-completion-task-test.mjs",
    "start": "node plugin/dist/index.js",
    "dev": "npm run build && npm run start",
    "typecheck": "tsc --noEmit -p plugin/tsconfig.json",
    "test:all": "npm run build && npm run typecheck && npm run test:skill-completion-task"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "express": "^5.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3"
  }
}
