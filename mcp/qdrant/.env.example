# Hybrid Qdrant MCP server (dense + sparse).
#
# Dense embeddings: local FastEmbed (BAAI/bge-small-en-v1.5, CPU only).
# Sparse embeddings: FastEmbed BM25 (Qdrant/bm25).
# No OpenAI dependency — the server embeds locally.
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=

COLLECTION_NAME=hybrid_docs
DENSE_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25

# stdio | streamable-http
MCP_TRANSPORT=streamable-http

# Bearer token required by the HTTP transport. WITHOUT it the server refuses
# every request — set it whenever the endpoint is reachable from outside
# (public hostname / tunnel).
QDRANT_MCP_TOKEN=
