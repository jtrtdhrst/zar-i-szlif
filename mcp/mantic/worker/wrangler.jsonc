{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mantic-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "mantic-mcp.zariszlif.pl",
      "custom_domain": true
    }
  ],
  "vars": {
    "MAUTIC_BASE_URL": "https://mautic.kompaszbiorek.pl/api/",
    "MAUTIC_TOKEN_ENDPOINT": "https://mautic.kompaszbiorek.pl/api/oauth/token"
  }
}
