# Mautic 7 API — OAuth2 client-credentials. All four are REQUIRED
# (the server refuses to start without them).
MAUTIC_BASE_URL=https://mautic.example.pl/api/
MAUTIC_CLIENT_ID=
MAUTIC_CLIENT_SECRET=
MAUTIC_TOKEN_ENDPOINT=https://mautic.example.pl/api/oauth/token

# HTTP bridge (Dockerfile.http) only.
BRIDGE_PORT=8090
# Optional shared secret; when set, requests must send `Authorization: Bearer <token>`.
BRIDGE_TOKEN=
