# HTTP bridge image: the stdio mantic-mcp server plus a Streamable HTTP facade.
#
# Self-contained on purpose: Coolify builds every service from its own folder,
# so this image cannot rely on a locally built `mantic-mcp:latest` tag.
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json tsconfig.json ./
COPY src ./src
RUN npm ci && npm run build && npm prune --omit=dev

FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/build ./build
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./

WORKDIR /app/bridge
COPY bridge-package.json ./package.json
RUN npm install --omit=dev
COPY bridge.mjs ./bridge.mjs

# Bridge env: BRIDGE_PORT, BRIDGE_TOKEN (optional), MANTIC_ENTRYPOINT
ENV BRIDGE_PORT=8090
EXPOSE 8090
ENTRYPOINT ["node", "/app/bridge/bridge.mjs"]
