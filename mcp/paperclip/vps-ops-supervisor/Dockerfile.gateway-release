# Layer on the hash-verified v1.0.20 supervisor without touching Paperclip Core.
FROM local/vps-ops-supervisor:1.0.20-komaa1458-candidate
LABEL org.opencontainers.image.version="1.0.21"
LABEL org.opencontainers.image.revision="KOMAA-1463-gateway-release"
COPY vps-ops-supervisor/apply-gateway-release.py /tmp/apply-gateway-release.py
COPY scripts/deploy-gateway-vps.sh /opt/sup/release/deploy-gateway-vps.sh
COPY scripts/recreate-gateway-argv.py /opt/sup/release/recreate-gateway-argv.py
COPY vps-ops-supervisor/test/gateway-release-matrix.test.sh /opt/sup/candidate-test/gateway-release-matrix.test.sh
RUN python3 /tmp/apply-gateway-release.py \
  && bash -n /opt/sup/watcher.sh \
  && bash -n /opt/sup/release/deploy-gateway-vps.sh \
  && python3 -m py_compile /opt/sup/release/recreate-gateway-argv.py \
  && bash /opt/sup/candidate-test/auth-matrix.test.sh /opt/sup/watcher.sh \
  && bash /opt/sup/candidate-test/gateway-release-matrix.test.sh /opt/sup/watcher.sh /opt/sup/candidate-test/auth-matrix.test.sh \
  && rm /tmp/apply-gateway-release.py
