# Paperclip MCP gateway — the MCP layer of the Paperclip control plane.
#
# This folder owns ONLY the MCP layer (gateway + patch). The Paperclip core
# (API/UI/scheduler/OAuth/migrations) is NOT vendored here: it ships as the
# upstream image ghcr.io/paperclipai/paperclip and must not be modified.
#
# PAPERCLIP_API_URL — base URL of the Paperclip API (without /api suffix is OK).
PAPERCLIP_API_URL=http://paperclip:3100/api
PAPERCLIP_PUBLIC_URL=https://paperclip.example.pl
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=private

# MCP gateway listener.
MCP_HOST=0.0.0.0
MCP_PORT=3101
MCP_PUBLIC_BASE_URL=https://paperclip-mcp.example.pl

# OAuth 2.1 layer for Claude Web custom connectors.
OAUTH_ACCESS_TTL_SEC=3600
OAUTH_REFRESH_TTL_SEC=2592000

# Paperclip instance / company the gateway acts for.
# PAPERCLIP_COMPANY_ID is REQUIRED — the gateway refuses to start without it
# ("FATAL: PAPERCLIP_COMPANY_ID must be set to a valid UUID").
PAPERCLIP_INSTANCE_ID=default
PAPERCLIP_COMPANY_ID=
PAPERCLIP_MCP_PROJECT_ID=
PAPERCLIP_MCP_AGENT_ID=
PAPERCLIP_MCP_RUN_ID=
