# Penpot MCP — self-hosted stack (native + headless + router)
#
# PENPOT_BASE_URL points at the Penpot instance the MCP talks to
# (e.g. http://penpot-frontend:8080 inside the Penpot compose network,
#  or https://penpot.kompaszbiorek.pl for the production instance).
PENPOT_BASE_URL=http://penpot-frontend:8080

# Headless MCP only: access token of a Penpot user with the API scope.
# Leave empty to start the server without credentials (tools that need auth fail).
PENPOT_ACCESS_TOKEN=
# HTTP mode REQUIRES the MCP auth token FILE (server refuses to start without it):
#   PENPOT_MCP_AUTH_TOKEN_FILE=/run/secrets/mcp-token
PENPOT_MCP_AUTH_TOKEN_FILE=/run/secrets/mcp-token
# Optional: only required for penpot_export_shape (same account as the token above).
PENPOT_LOGIN_EMAIL=
PENPOT_LOGIN_PASSWORD=
