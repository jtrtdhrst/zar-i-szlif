# OpenDesign daemon
# Container should share open-design_default with the OpenDesign daemon.
OD_API_TOKEN=
# OD_BASE_URL=http://open-design:7456
# OD_HOST=open-design
# OD_PORT=7456

# Remote Streamable HTTP MCP. TLS is terminated by the reverse proxy/tunnel.
MCP_HTTP_PORT=8092
MCP_AUTH_TOKEN=

# Canonical Design System writes are fail-closed unless explicitly enabled.
BRAND_WRITE_ENABLED=true

# upload_brand_asset limits (decoded binary bytes / full HTTP request bytes).
BRAND_ASSET_MAX_BYTES=5000000
MCP_MAX_BODY_BYTES=7500000
