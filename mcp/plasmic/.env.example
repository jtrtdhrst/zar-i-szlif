# Plasmic MCP
#
# Snapshot of the `ops/design-stack` service that builds the running container
# `design-stack/plasmic-mcp:20261010-fixturefix` (CI publishes the same tree as
# `ghcr.io/miloszspyrka-code/kompas-zbiorek-opendesign-mcp:<sha>`).
#
# PLASMIC_BASE_URL must be the PUBLIC https URL of the Plasmic instance —
# the WAB sets a Secure session cookie only over HTTPS/proxy, otherwise the
# login fails with CSRF.
PLASMIC_BASE_URL=https://plasmic.example.pl
PLASMIC_EMAIL=
PLASMIC_PASSWORD=
PLASMIC_MCP_TOKEN=

MCP_HTTP_PORT=8091
PLASMIC_STATE_DIR=/state
PAPERCLIP_AGENT_ID=
PAPERCLIP_RUN_ID=

# Only for the second server in the same image (opendesign-bridge-mcp).
OD_HOST=open-design
OD_PORT=7456
OD_API_TOKEN=
OPENDESIGN_BRIDGE_TOKEN=
OPENDESIGN_BRAND_WRITE_ENABLED=true
