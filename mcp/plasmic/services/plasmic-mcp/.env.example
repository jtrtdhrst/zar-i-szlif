# Wymagane
# Ten kontener MUSI być wpięty w sieć plasmic_default:
#   docker network connect plasmic_default <kontener>
# (OpenCode rozwiązuje nazwę plasmic-wab TYLKO w tej sieci).
# PLASMIC_BASE_URL obsługiwane dla kompatybilności (nadpisuje host:port).
# PLASMIC_BASE_URL=http://plasmic-wab:3004
# PLASMIC_HOST=plasmic-wab
# PLASMIC_PORT=3004
# Jedna z form auth (sesja preferowana — dedykowany user Plasmic):
PLASMIC_EMAIL=agent@example.com
PLASMIC_PASSWORD=
# ...albo rotowalny team token:
# PLASMIC_TEAM_TOKEN=

# Stan lokalny (locki, idempotencja, audyt, seen)
PLASMIC_STATE_DIR=./var/plasmic-mcp

# HTTP dla zdalnych klientów (puste = tylko stdio). Za TLS odpowiada reverse proxy.
# MCP_HTTP_PORT=8091
# MCP_AUTH_TOKEN= — jeden token lub lista MCP_AUTH_TOKENS=a,b,c (rotowalne, per klient)
