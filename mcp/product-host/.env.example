# Copy to .env for local runs. Placeholders only — never commit real values.
# The values below are the *names* of the secrets the deployment must supply.

# HTTP port (default 8080)
PORT=8080

# Public origin this service is reachable at; used for the RFC 9728 metadata
# document and the WWW-Authenticate challenge. Production: https://mcp.zariszlif.pl
MCP_PUBLIC_ORIGIN=http://127.0.0.1:8080

# Supabase project URL used server-side for PostgREST calls.
# In self-hosted Supabase this may be an internal Docker alias
# (http://api-gw-…:8000) that only the stack itself can resolve.
SUPABASE_URL=https://your-project-ref.supabase.co

# Client-visible Supabase origin, used ONLY for the auth server advertised in
# /.well-known/oauth-protected-resource. Must be reachable by MCP clients.
# Self-hosted Supabase: this is API_EXTERNAL_URL, e.g.
#   https://supabase-staging.51.89.174.58.sslip.io
# API_EXTERNAL_URL is accepted as a fallback name. REQUIRED when NODE_ENV is
# production: the service refuses to start rather than advertise an internal host.
SUPABASE_PUBLIC_URL=https://your-project-ref.supabase.co
# API_EXTERNAL_URL=https://your-project-ref.supabase.co

# Supabase anon/publishable key (public by design). NEVER the service-role key.
SUPABASE_ANON_KEY=replace-with-supabase-anon-key

# HS256 secret Supabase Auth signs user access tokens with.
# Project Settings -> API -> JWT Settings -> JWT Secret.
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret

# Optional: pin the `iss` claim, e.g. https://<project-ref>.supabase.co/auth/v1
# SUPABASE_JWT_ISSUER=

# debug | info | warn | error (default info)
LOG_LEVEL=info

# Deployment environment reported in every tool response, so a caller can tell
# staging from production (max 64 chars, trimmed; empty -> "unknown").
# Informational only — it selects no behaviour. Examples: staging, production
MCP_ENVIRONMENT=unknown
