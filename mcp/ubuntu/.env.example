# ubuntu-mcp-bridge — authenticated Streamable HTTP MCP in front of
# mcp-ssh-manager (stdio) → SSH → Ubuntu host.
#
# The bearer token file and the SSH key must be mounted as files (read-only),
# never passed as env vars — the bridge reads the token from
# BRIDGE_TOKEN_FILE on startup and fails closed when it is empty.
BRIDGE_PORT=8765
BRIDGE_TOKEN_FILE=/bridge-config/bridge-bearer-token
BRIDGE_CHILD_CMD=node
BRIDGE_CHILD_ARGS=/opt/node_modules/mcp-ssh-manager/src/index.js
BRIDGE_AUDIT_FILE=/audit/ubuntu-mcp-audit.jsonl
BRIDGE_CALL_TIMEOUT_MS=120000

# Target host (the managed VPS).
SSH_SERVER_UBUNTU_HOST=51.89.174.58
SSH_SERVER_UBUNTU_USER=harness-ops
SSH_SERVER_UBUNTU_PORT=22
SSH_SERVER_UBUNTU_KEYPATH=/bridge-config/harness-ops
SSH_SERVER_UBUNTU_MODE=unrestricted
SSH_MANAGER_KNOWN_HOSTS=/bridge-config/known_hosts
SSH_LOG_LEVEL=INFO
SSH_SERVER_UBUNTU_AUDIT_LOG=/audit/ssh-manager-audit.jsonl
