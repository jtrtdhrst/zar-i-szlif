FROM node:22-bookworm-slim
RUN npm i -g comfyui-mcp@0.52.206 && comfyui-mcp --version
# Durable production patches (see patch-v1.mjs in this folder + repo mcp/comfyui/):
# - upload_image data_base64 (remote AI clients, SHA-256, magic-byte check, 30MB cap)
# - train_doctor ready_for_training / diagnostic_completed (no false success)
# - COMFYUI_URL env fixes Prompt Director remote routing (127.0.0.1 bug)
COPY patch-v1.mjs /tmp/patch-v1.mjs
RUN node /tmp/patch-v1.mjs && rm /tmp/patch-v1.mjs
EXPOSE 9100
ENV LOG_LEVEL=info COMFYUI_URL=http://comfyui:8188
CMD ["comfyui-mcp", "--http", "--host", "0.0.0.0", "--port", "9100", "--comfyui-url", "http://comfyui:8188", "--allow-unauthenticated-non-loopback"]
