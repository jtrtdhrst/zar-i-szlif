# ComfyUI MCP — non-secret configuration. Secrets live in host env / Cloudflare, never here.
COMFYUI_URL=http://comfyui:8188
# Origin token (comfy-mcp --token / COMFYUI_MCP_HTTP_TOKEN). Set on host compose env when locking down.
COMFYUI_MCP_HTTP_TOKEN=
# Worker edge (Cloudflare Worker secrets, Settings → Variables and Secrets).
MCP_AUTH_TOKEN=
UPSTREAM_TOKEN=
# Public endpoints (unchanged by Worker cutover).
COMFYUI_PUBLIC_URL=https://comfy.kompaszbiorek.pl/
COMFY_MCP_PUBLIC_URL=https://mcp-comfy.kompaszbiorek.pl/mcp
COMFY_ENGINE_URL=https://comfy-engine.zariszlif.pl/mcp
