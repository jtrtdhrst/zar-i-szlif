{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "langfuse-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "langfuse-mcp.zariszlif.pl",
      "custom_domain": true
    }
  ],
  "vars": {
    "UPSTREAM_URL": "https://langfuse-engine.zariszlif.pl/api/public/mcp"
  }
}
