{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "penpot-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "penpot-mcp.zariszlif.pl",
      "custom_domain": true
    }
  ],
  "vars": {
    "UPSTREAM_URL": "https://penpot-engine.zariszlif.pl/mcp/stream",
    "UPSTREAM_TOKEN_PARAM": "userToken"
  }
}
