{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zzprobe-mcp",
  "main": "src/zzprobe.ts",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "routes": [{ "pattern": "zzprobe-mcp.zariszlif.pl", "custom_domain": true }],
  "vars": { "UPSTREAM_URL": "https://qdrant-engine.zariszlif.pl/mcp" }
}
