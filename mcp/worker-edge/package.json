{
  "name": "mcp-worker-edge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm ci --include=dev --no-audit --no-fund && npm run typecheck && npm test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "deploy": "echo 'Deploy: npx wrangler deploy --config wrangler.<usluga>.jsonc'"
  },
  "dependencies": {},
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "typescript": "^5.8.3",
    "wrangler": "^4.123.0"
  },
  "description": "Wspolna krawedz MCP (9 uslug) — konfiguracje per usluga"
}
