{
  "name": "kompas-zbiorek-ui-plugin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node web/scripts/build-static.mjs && node node_modules/typescript/bin/tsc -p server/tsconfig.json",
    "test:skill-completion-task": "node web/scripts/skill-completion-task-test.mjs",
    "start": "node server/dist/index.js",
    "dev": "npm run build && npm run start",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p server/tsconfig.json && node node_modules/typescript/bin/tsc --noEmit -p web/tsconfig.json",
    "test:ui": "playwright test --config playwright.config.ts",
    "test:a11y": "playwright test e2e/a11y.spec.ts --config playwright.config.ts",
    "test:visual": "playwright test e2e/visual.spec.ts --config playwright.config.ts",
    "test:ui:update": "playwright test e2e/visual.spec.ts --config playwright.config.ts --update-snapshots",
    "test:all": "npm run build && npm run test:ui"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "express": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.3",
    "esbuild": "^0.25.2",
    "typescript": "^5.8.3"
  }
}
