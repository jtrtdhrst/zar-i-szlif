# Cloudflare Worker non-secret configuration.
TEMPLATE_FILE_ID=
SHEETS_TEMPLATE_FILE_ID=
GOOGLE_CLOUD_PROJECT_NUMBER=
SENDER_ONBOARDING_ENABLED=false
SENDER_ONBOARDING_GROUP=onboarding-sekwencja

# OAuth and optional integration secrets. Set with `wrangler secret put`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
COOKIE_ENCRYPTION_KEY=
GOOGLE_PICKER_API_KEY=
SENDER_API_TOKEN=

# RAG/Qdrant (KOMAA-400). Wartości nigdy w repo — wiąż jako secret_ref z katalogu
# firmy; adres i zakres klucza: docs/KOMAA-385-rag2.md, sekcja "Live run".
QDRANT_URL=
