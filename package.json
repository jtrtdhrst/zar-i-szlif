{
  "name": "zar-i-szlif-mcp-infrastructure",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "node --check scripts/check-mcp-endpoints.mjs && node --check scripts/mcp-oauth-smoke.mjs && node --check scripts/assert-git-identity.mjs",
    "test": "node --test tests/repo-identity-guard.test.mjs",
    "build": "node -e \"console.log('Standalone MCP builds live under mcp/<service>')\"",
    "validate:code": "npm run lint && npm test",
    "validate:frontend": "npm run validate:code",
    "validate:worker": "npm run validate:code",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
