# Persistent Emailens MCP HTTP bridge. Only the stdio backend idles; the
# authenticated listener remains available to respawn it on demand.
FROM local/emailens-mcp:0.10.0

USER root
RUN npm install -g express@4.21.2 --no-audit --no-fund \
  && npm cache clean --force \
  && node -e "require('/usr/local/lib/node_modules/express/package.json');require('/usr/local/lib/node_modules/@emailens/mcp/node_modules/@modelcontextprotocol/sdk/package.json')"

COPY bridge.mjs /app/bridge.mjs
# ESM ignores NODE_PATH, so link deps next to the bridge (pinned at build time).
RUN mkdir -p /app/node_modules/@modelcontextprotocol \
  && ln -s /usr/local/lib/node_modules/express /app/node_modules/express \
  && ln -s /usr/local/lib/node_modules/@emailens/mcp/node_modules/@modelcontextprotocol/sdk /app/node_modules/@modelcontextprotocol/sdk \
  && cd /app && node --input-type=module -e "await import('express');await import('@modelcontextprotocol/sdk/server/index.js');console.log('deps ok')" \
  && ls -la /app/node_modules/ /app/node_modules/@modelcontextprotocol/
RUN chown -R node:node /app && chmod 644 /app/bridge.mjs

ENV PORT=3100 \
    MCP_PATH=/mcp \
    IDLE_SECONDS=600
WORKDIR /home/node
USER node

ENTRYPOINT ["node", "/app/bridge.mjs"]
