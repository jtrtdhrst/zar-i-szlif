# Emailens MCP — stdio image (production, TTL enforced inside the image).
# Pinned base + pinned package. Deps installed at BUILD time, never at run.
# No ports, no API key, runs as non-root, stdio stays clean (logs -> stderr).
FROM node:24.21.0-trixie-slim@sha256:173f125896c3b47ddf056734c7ea789d04595a6a08769a8f78e0df642781fb66

RUN npm install -g @emailens/mcp@0.10.0 --no-audit --no-fund \
  && npm cache clean --force \
  && test -x /usr/local/bin/emailens-mcp \
  && test -f /usr/local/lib/node_modules/@emailens/mcp/dist/index.js \
  && node --version && timeout --version | head -1

WORKDIR /home/node
USER node

# Total instance lifetime: SIGTERM at 900s, SIGKILL 10s later.
# Hardcoded on purpose: MUST NOT be overridable via environment.
# Tests use a shorter limit via --entrypoint override (same GNU timeout mechanism).
ENTRYPOINT ["timeout", "-k", "10", "900", "node", "/usr/local/lib/node_modules/@emailens/mcp/dist/index.js"]
