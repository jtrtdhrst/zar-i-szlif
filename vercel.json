{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "app/web/dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/panel",
      "destination": "https://panel.kompaszbiorek.pl/panel",
      "permanent": false
    },
    {
      "source": "/panel/:path*",
      "destination": "https://panel.kompaszbiorek.pl/panel/:path*",
      "permanent": false
    }
  ]
}
