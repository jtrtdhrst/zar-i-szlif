# Self-hosted Plasmic — required runtime environment.
# Copy to .env for local runs; in Coolify set these as application environment variables.

# Public origin of Studio. Must match the domain served by Coolify (cookies + GitHub App callback).
PLASMIC_PUBLIC_URL=https://plasmic.example.com

POSTGRES_USER=wab
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wab

# JSON array, e.g. ["admin@example.com"]
ADMIN_EMAILS=["admin@example.com"]

SESSION_SECRET=change-me

# base64 of the GitHub App secrets.json:
# {"github":{"appId":...,"privateKey":"...","oauth":{"clientId":"...","clientSecret":"..."}}}
PLASMIC_GITHUB_SECRETS_B64=
