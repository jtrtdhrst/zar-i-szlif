# Public client-side PostHog Project Token (EU project 265172).
# Store the actual token in each deployment environment; do not commit .env files.
# Not an admin/personal/secret API key. Use one PostHog project for production.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_replace_with_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# If a generated site uses Vite, replace NEXT_PUBLIC_* with VITE_* at build time.
VITE_POSTHOG_PROJECT_TOKEN=phc_replace_with_project_token
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Product-owned server/MCP (independent of frontend env conventions).
POSTHOG_PROJECT_TOKEN=phc_replace_with_project_token
POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_SERVER_ENABLED=false
