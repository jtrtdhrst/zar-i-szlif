{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/hy3-free",
  "agent": {
    "ctb-plan": {
      "mode": "all",
      "description": "CTB DIAGNOSE/PLAN: read-only inference without writes and without downstream MCP.",
      "prompt": "Jestes agentem diagnostyczno-planowym CTB. Wykonywuj wylacznie odczyt i analize. Zabranione: edycja plikow, polecenia powloki, jakiekolwiek narzedzia MCP (git, cloudflare, playwright, shadcn, storybook, sender). PLAN konczy sie konkretnym planem implementacji.",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "git_*": "deny",
        "cloudflare_*": "deny",
        "playwright_*": "deny",
        "shadcn_*": "deny",
        "kompas-storybook_*": "deny",
        "sender_*": "deny"
      }
    },
    "ctb-executor": {
      "mode": "all",
      "description": "CTB EXECUTE bez dodatkowych dev MCP (fail-closed dla nieznanych principalow).",
      "prompt": "Jestes egzekutorem CTB. Dzialasz wylacznie w kanonicznie autoryzowanym katalogu issue. Downstream MCP jest wylaczony.",
      "permission": {
        "bash": {
          "git *": "deny",
          "gh *": "deny",
          "wrangler *": "deny",
          "*": "allow"
        },
        "git_*": "deny",
        "cloudflare_*": "deny",
        "playwright_*": "deny",
        "shadcn_*": "deny",
        "kompas-storybook_*": "deny",
        "sender_*": "deny"
      }
    },
    "ctb-engineer": {
      "mode": "all",
      "description": "CTB EXECUTE dla inzyniera: Git dozwolony, reszta dev MCP denied.",
      "prompt": "Jestes egzekutorem CTB z dostepem do Git. Pozostale dev MCP sa zablokowane; potrzebne granty wymagaja issue-scoped override.",
      "permission": {
        "git_*": "allow",
        "cloudflare_*": "deny",
        "playwright_*": "deny",
        "shadcn_*": "deny",
        "kompas-storybook_*": "deny",
        "sender_*": "deny"
      }
    },
    "ctb-designer": {
      "mode": "all",
      "description": "CTB EXECUTE dla designera UI: Shadcn + Storybook, reszta denied.",
      "prompt": "Jestes egzekutorem CTB dla prac UI/design. Dozwolone: Shadcn i Storybook. Git/Playwright/Cloudflare/Sender zablokowane.",
      "permission": {
        "bash": {
          "git *": "deny",
          "gh *": "deny",
          "wrangler *": "deny",
          "*": "allow"
        },
        "shadcn_*": "allow",
        "kompas-storybook_*": "allow",
        "git_*": "deny",
        "cloudflare_*": "deny",
        "playwright_*": "deny",
        "sender_*": "deny"
      }
    },
    "ctb-ui-qa": {
      "mode": "all",
      "description": "CTB EXECUTE dla UI QA: Playwright, reszta denied.",
      "prompt": "Jestes egzekutorem CTB dla akceptacji e2e. Dozwolone: Playwright. Git/Shadcn/Storybook/Cloudflare/Sender zablokowane.",
      "permission": {
        "bash": {
          "git *": "deny",
          "gh *": "deny",
          "wrangler *": "deny",
          "*": "allow"
        },
        "playwright_*": "allow",
        "git_*": "deny",
        "cloudflare_*": "deny",
        "shadcn_*": "deny",
        "kompas-storybook_*": "deny",
        "sender_*": "deny"
      }
    },
    "ctb-cto-infra": {
      "mode": "all",
      "description": "CTB EXECUTE dla CTO infra/deploy: Cloudflare, reszta denied.",
      "prompt": "Jestes egzekutorem CTB dla infra/deploy. Dozwolone: Cloudflare (takze wrangler CLI). Git/Playwright/Shadcn/Storybook/Sender zablokowane.",
      "permission": {
        "bash": {
          "git *": "deny",
          "gh *": "deny",
          "*": "allow"
        },
        "cloudflare_*": "allow",
        "git_*": "deny",
        "playwright_*": "deny",
        "shadcn_*": "deny",
        "kompas-storybook_*": "deny",
        "sender_*": "deny"
      }
    }
  },
  "mcp": {
    "paperclip": {
      "type": "remote",
      "url": "https://paperclip-mcp.kompaszbiorek.pl/mcp",
      "enabled": false
    },
    "paperclip-local": {
      "type": "remote",
      "url": "http://127.0.0.1:3101/mcp",
      "enabled": true,
      "oauth": false
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": false,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": false
    },
    "shadcn": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "shadcn@latest",
        "mcp"
      ],
      "enabled": false
    },
    "playwright": {
      "type": "local",
      "command": [
        "pnpm",
        "exec",
        "playwright-mcp"
      ],
      "enabled": false
    },
    "kompas-storybook": {
      "type": "remote",
      "url": "http://127.0.0.1:6006/mcp",
      "enabled": false
    },
    "radzen-blazor": {
      "type": "remote",
      "url": "https://app.radzen.com/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "X-Radzen-Key": "{env:RADZEN_BLAZOR_KEY}"
      }
    },
    "radzen-blazor-studio": {
      "type": "local",
      "command": [
        "dotnet",
        "c:\\Program Files\\Radzen Blazor Studio\\resources\\Radzen.Server\\Radzen.Server.dll",
        "--mcp"
      ],
      "enabled": false
    },
    "npm-run-scripts": {
      "enabled": false
    },
    "npm-publish-tool": {
      "enabled": false
    },
    "nocobase": {
      "enabled": false
    }
  },
  "lsp": {},
  "permission": {
    "bash": {
      "*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git push*": "allow",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git pull*": "allow",
      "npm *": "allow",
      "npx wrangler *": "allow",
      "wrangler *": "allow",
      "node *": "allow"
    }
  }
}
