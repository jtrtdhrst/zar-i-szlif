{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/x-preview-f-free",
  "mcp": {
    "paperclip": {
      "type": "remote",
      "url": "https://mcp.kompaszbiorek.pl/mcp",
      "enabled": true
    },
    "paperclip-local": {
      "type": "remote",
      "url": "http://127.0.0.1:3104/mcp",
      "enabled": true,
      "oauth": false
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": true
    },
    "shadcn": {
      "type": "remote",
      "url": "http://127.0.0.1:4173/mcp",
      "enabled": true,
      "oauth": false
    },
    "playwright": {
      "type": "local",
      "command": [
        "pnpm",
        "exec",
        "playwright-mcp"
      ],
      "enabled": true
    },
    "kompas-storybook": {
      "type": "remote",
      "url": "http://127.0.0.1:6006/mcp",
      "enabled": true,
      "oauth": false
    }
  },
  "lsp": {},
  "permission": {
    "bash": {
      "*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git push*": "allow",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git pull*": "allow",
      "npm *": "allow",
      "npx wrangler *": "allow",
      "wrangler *": "allow",
      "node *": "allow"
    }
  }
}
