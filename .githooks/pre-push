#!/bin/sh
set -eu

while read local_ref local_sha remote_ref remote_sha
do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "[pre-push] Direct pushes to main are blocked."
    echo "[pre-push] Push a branch and merge through a PR after CI passes."
    exit 1
  fi
done

echo "[pre-push] Running Kompas release gate (Vercel + Cloudflare)..."
exec npm run validate:release
