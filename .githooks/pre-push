#!/bin/sh
set -eu

shas=""
commits=""

while read -r local_ref local_sha remote_ref remote_sha
do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "[pre-push] Direct pushes to main are blocked."
    echo "[pre-push] Push a branch and merge through a PR after CI passes."
    exit 1
  fi
  case "$local_sha" in
    ""|0*) ;;  # ref deletion — nothing to validate
    *) shas="$shas $local_sha" ;;
  esac
  case "$local_sha" in
    ""|0*) ;;  # ref deletion — no new commits to inspect
    *)
      case "$remote_sha" in
        ""|0*)
          base=$(git merge-base origin/main "$local_sha") || {
            echo "[identity-gate] FAIL — cannot resolve origin/main; run: git fetch origin main"
            exit 1
          }
          range="$base..$local_sha"
          ;;
        *) range="$remote_sha..$local_sha" ;;
      esac
      new_commits=$(git rev-list "$range") || {
        echo "[identity-gate] FAIL — cannot list new commits in $range"
        exit 1
      }
      if [ -n "$new_commits" ]; then
        commits="$commits $new_commits"
      fi
      ;;
  esac
done

if [ -n "$commits" ]; then
  # Identity gate runs before the release gate: synthetic author/committer
  # identities never reach push/production. CI re-checks the same rule server-side,
  # so --no-verify is never the normal path.
  # shellcheck disable=SC2086
  node scripts/assert-git-identity.mjs $commits || exit 1
fi

if [ -z "$(git status --porcelain)" ]; then :; else
  echo "[pre-push] Refusing to gate a dirty working tree."
  echo "[pre-push] A dirty tree means the validated content is not the pushed content."
  exit 1
fi

# shellcheck disable=SC2086
exec node scripts/release-targets.mjs $shas
