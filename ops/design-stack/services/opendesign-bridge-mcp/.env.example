# Wymagane
# OD_BASE_URL obsługiwane dla kompatybilności, ale ten kontener MUSI być wpięty
# w sieć open-design_default: docker network connect open-design_default <kontener>
# (OpenCode rozwiązuje nazwę open-design TYLKO w tej sieci).
# OD_BASE_URL=http://open-design:7456
# OD_HOST=open-design
# OD_PORT=7456
OD_API_TOKEN=

# HTTP dla zdalnych klientów (puste = tylko stdio). Za TLS odpowiada reverse proxy.
# MCP_HTTP_PORT=8092
# MCP_AUTH_TOKEN= — rotowalny, osobny niż dla plasmic-mcp
