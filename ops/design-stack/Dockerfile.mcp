FROM node:24-alpine
WORKDIR /app
COPY package.json package-lock.json ./
COPY libs/contracts/package.json ./libs/contracts/
COPY libs/plasmic-client/package.json ./libs/plasmic-client/
COPY libs/mcp-server/package.json ./libs/mcp-server/
COPY services/plasmic-mcp/package.json ./services/plasmic-mcp/
RUN npm ci --omit=dev --ignore-scripts
COPY libs/contracts ./libs/contracts
COPY libs/plasmic-client ./libs/plasmic-client
COPY libs/mcp-server ./libs/mcp-server
COPY services/plasmic-mcp ./services/plasmic-mcp
RUN adduser -D -u 10001 mcp && mkdir -p /state && chown -R mcp:mcp /app /state
USER mcp
EXPOSE 8091
CMD ["node", "services/plasmic-mcp/server.ts"]
